{
  "title": "Semantic Cache Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Cache Hit Rate",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(cache_hits_total) / clamp_min(sum(cache_requests_total), 1)",
          "legendFormat": "Hit rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Estimated Cost Saved (USD)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(estimated_cost_saved_usd_total)", "legendFormat": "USD saved" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Entries in Cache",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "cache_entries_total", "legendFormat": "entries" }]
    },
    {
      "type": "timeseries",
      "title": "Requests: Hits vs Misses",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rate(cache_hits_total[1m])", "legendFormat": "Hits/sec" },
        { "expr": "rate(cache_misses_total[1m])", "legendFormat": "Misses/sec" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency (P50/P95) by Cache Status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(request_latency_seconds_bucket[5m])) by (le, cache_status))",
          "legendFormat": "P50 {{cache_status}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(request_latency_seconds_bucket[5m])) by (le, cache_status))",
          "legendFormat": "P95 {{cache_status}}"
        }
      ]
    }
  ]
}
