{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Semantic Cache API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Demo Script",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Load Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_test.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
