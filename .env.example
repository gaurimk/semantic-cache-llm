# -----------------------------------------------------------------------
# Copy this file to ".env" and edit as needed:   cp .env.example .env
# Every setting below is optional — the app works with zero changes.
# Nothing here requires a paid account or API key.
# -----------------------------------------------------------------------

# Where Ollama (your free, local LLM) is running.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Which local model Ollama should use by default.
# Pull it first with:  ollama pull llama3.2:1b
DEFAULT_MODEL=llama3.2:1b

# Free, local embedding model (downloaded once from Hugging Face, then offline).
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Where the local vector cache database stores its files on disk.
CHROMA_PERSIST_DIR=./cache_data
COLLECTION_NAME=llm_semantic_cache

# How similar (0.0 - 1.0) a new question must be to a cached one to count
# as "the same question". Higher = safer but fewer cache hits.
SIMILARITY_THRESHOLD=0.95

# How close to the threshold counts as a "near miss" worth logging for
# later analysis (see scripts/analyze_near_misses.py).
NEAR_MISS_MARGIN=0.10

# How long cached answers live before they expire, in seconds.
DEFAULT_TTL_SECONDS=86400
SHORT_TTL_SECONDS=3600

LOG_DIR=./logs
ENABLE_METRICS=true

# Purely illustrative — used only to print a "money saved" estimate.
ESTIMATED_COST_PER_1K_TOKENS_USD=0.002
